# Whisper Model Configuration
# Options: tiny, base, small, medium, large
# Defaults to "small" (good quality/footprint balance). Use "medium" or
# "large" for higher accuracy on long videos.
WHISPER_MODEL=small

# Output Directory
TRANSCRIPTS_DIR=transcripts

# Temporary Files Directory (for audio downloads)
TEMP_DIR=/tmp

# Audio Quality (kbps)
AUDIO_QUALITY=192

# Default Language (set to None for auto-detection)
# Examples: en, es, fr, de, ja, zh
DEFAULT_LANGUAGE=en

# Enable GPU if available
USE_GPU=true

# Max video duration in seconds (10800 = 3 hours)
MAX_VIDEO_DURATION=10800

# Show timestamped segments in transcript
INCLUDE_TIMESTAMPS=true

# Verbose output for debugging
DEBUG_MODE=false

# Actionable-points summary (strips sponsors/filler) via the OpenAI API.
# Enabled by default, but only runs when an API key is set below.
SUMMARIZE=true

# OpenAI API key, required for summaries. Get one at https://platform.openai.com
# OPENAI_API_KEY=sk-...

# Model used for summaries (defaults to gpt-5.5).
# SUMMARY_MODEL=gpt-5.5

# YouTube player clients used for extraction (comma-separated).
# Defaults to clients that avoid YouTube's bot-gating, which otherwise makes
# public videos fail with misleading "Private video" errors. Set to "default"
# to use yt-dlp's built-in client selection.
# YOUTUBE_PLAYER_CLIENTS=tv,web_safari,mweb,android_vr

# YouTube Cookie Authentication (choose one method)
# Method 1: Extract cookies from browser (chrome, firefox, safari, edge, etc.)
# COOKIES_FROM_BROWSER=chrome

# Method 2: Use a cookies file (Netscape format)
# COOKIES_FILE=/path/to/cookies.txt